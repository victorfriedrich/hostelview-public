# Copy to backend/.env. `make` targets use the local database from docker-compose.yml
# regardless of DATABASE_URL here.
DATABASE_URL=postgresql://postgres:hostelview@localhost:54329/hostelview

# Browser origins allowed to call the API, comma-separated; * allows any.
CORS_ORIGINS=*

# Only for the LLM rating jobs (app.jobs.rate, app.jobs.classify_hosting).
OPENROUTER_API_KEY=
